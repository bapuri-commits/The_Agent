# ============================================
# The Agent — Environment Variables
# ============================================
# 이 파일을 .env로 복사한 후 실제 값을 채워 넣으세요.
# .env 파일은 절대 git에 커밋하지 마세요!

# --- LLM API Keys ---
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# --- Database ---
POSTGRES_USER=theagent
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=theagent
DATABASE_URL=postgresql+asyncpg://theagent:change-this-password@db:5432/theagent

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-this-secret-key
ALLOWED_ORIGINS=http://localhost:5173

# --- Telegram (Phase 3, 보조 알림) ---
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# --- Obsidian Vault Path (Phase 2) ---
# OBSIDIAN_VAULT_PATH=/path/to/The Record
